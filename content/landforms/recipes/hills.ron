// Hills (pipeline §8.3): billow with a strong domain warp and a mild erosion
// filter. The uplift curve scales the amplitude (200–400 m per body) to about
// 50–400 m locally.
Recipe(
    schema: 1,
    output: "out",
    graph: [
        ("base", Billow(base_wavelength_m: 2048.0, min_wavelength_m: 32.0, gain: 0.5, salt: 11)),
        ("warp", Warp(input: "base", strength_m: 1500.0, base_wavelength_m: 8192.0, octaves: 2, salt: 12)),
        ("erode", ErosionFilter(input: "warp", strength: 0.3, base_wavelength_m: 512.0, octaves: 3, salt: 13)),
        ("scale", Curve(input: Field(Uplift), points: [(0.0, 0.25), (0.5, 1.0)])),
        ("out", Multiply(a: "erode", b: "scale")),
    ],
)
