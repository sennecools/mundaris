// Life on Rust (genesis design §2–§3): the inputs of the planet palette.
// PROTOTYPE: the star's effective temperature lives here until the scene
// carries stellar data (Sol is Sun-like: 5772 K; the sun colour in
// content/lighting.json is consistent with it).
PlanetLife(
    schema: 1,
    body: "rust",
    star_temperature_k: 5772.0,
    // Earth-like air (Rust has oceans, rain and forests).
    atmosphere: (pressure_bar: 0.9, composition: NitrogenOxygen),
    // content/lighting.json body albedo of Rust.
    ground_albedo: (0.26, 0.15, 0.09),
    seed: 7,
    // User decision 2026-10-10: a per-planet dial, Rust about 0.4; the look
    // is plausible but stylised.
    strangeness: 0.4,
    realism: 0.5,
    // Old continental surfaces: weathered, rounded rocks where it is wet.
    geology_age: 0.7,
    // Hard bedrock (most of Rust, Tier A hardness ~0.85) breaks into granite
    // blocks; soft basins carry bedded sandstone.
    rocks: [
        (name: "granite", hardness: (min: 0.55, max: 1.0, falloff: 0.1)),
        (name: "sandstone", hardness: (min: 0.0, max: 0.5, falloff: 0.1)),
    ],
)
