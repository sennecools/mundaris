// Life on Rust (genesis design §2–§3): the inputs of the planet palette.
// PROTOTYPE: the star's effective temperature lives here until the scene
// carries stellar data (Sol is Sun-like: 5772 K; the sun colour in
// content/lighting.json is consistent with it).
PlanetLife(
    schema: 1,
    body: "rust",
    star_temperature_k: 5772.0,
    // Earth-like air (Rust has oceans, rain and forests).
    atmosphere: (pressure_bar: 0.9, composition: NitrogenOxygen),
    // content/lighting.json body albedo of Rust.
    ground_albedo: (0.26, 0.15, 0.09),
    seed: 7,
    // Strangeness drives the look (realism follows it unless set):
    // - 0.4 = the user's 2026-10-10 choice (familiar trees with alien
    //   details, palette close to Earth greens, realism 0.5);
    // - 0.7 = PROPOSAL after the user's alien line-up reference: mostly alien
    //   body plans, saturated violet/red/orange families (realism 0.85).
    // Currently 0.4 (the user's choice) until the user picks; set 0.7 for the
    // proposal.
    strangeness: 0.4,
    // Old continental surfaces: weathered, rounded rocks where it is wet.
    geology_age: 0.7,
    // Species: 10 generated from the planet (body plans, niches, colours),
    // the authored files in content/flora/species serving as tree/shrub
    // templates. 0 = only the authored species. PROTOTYPE: 0 until the
    // forest LOD chain is fixed (user 2026-10-10); 10 is the intended value.
    generated_species: 0,
    // Hard bedrock (most of Rust, Tier A hardness ~0.85) breaks into granite
    // blocks; soft basins carry bedded sandstone.
    rocks: [
        (name: "granite", hardness: (min: 0.55, max: 1.0, falloff: 0.1)),
        (name: "sandstone", hardness: (min: 0.0, max: 0.5, falloff: 0.1)),
    ],
    // Foliage build (art direction 2026-10-10): Stylised = a few big soft
    // clumps per crown; Realistic = the individual leaves, for comparison.
    foliage: Stylised,
)
