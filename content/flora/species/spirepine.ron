// Conifer analogue for Rust (strangeness ~0.4): whorled, cone-shaped crown
// that sheds snow; the whorls twist 60 degrees per node instead of Earth's
// stacked whorls. Replaces the M5 placeholder "conifer".
SpeciesFile(
    schema: 1,
    name: "spirepine",
    role: Conifer,
    genome: (
        form: Tree,
        height_m: 18.0,
        stems: 1,
        crown_base: 0.22,
        crown_aspect: 0.6,
        crown_shape: Cone,
        apical_dominance: 0.72,
        axis_mode: Monopodial,
        vigor: 2.0,
        cycles: 16,
        buds_per_node: 3,
        branch_angle_deg: 78.0,
        branch_angle_per_order_deg: -18.0,
        phyllotaxis_deg: 60.0,
        internode_m: 0.6,
        internode_per_order: 0.7,
        max_order: 3,
        space_seeking: 0.8,
        gravitropism: 0.6,
        gravitropism_per_order: -0.45,
        straightness: 1.6,
        wind_bias: 0.0,
        wobble: 0.12,
        pipe_exponent: 2.4,
        tip_radius_m: 0.012,
        flare: 0.6,
        stiffness: 0.6,
        shed_threshold: 0.4,
        cross_section: Round,
        surface: Scaled,
        organ: Needle,
        organ_size_m: 0.6,
        organ_cluster: 3,
        organ_orientation: Along,
        organ_reach: 4,
        fruit: Pod,
        fruit_size_m: 0.14,
        fruit_chance: 0.08,
    ),
    ecology: (
        footprint_m: 3.0,
        temperature_c: (min: -8.0, max: 16.0, falloff: 4.0),
        moisture: (min: 0.30, max: 1.0, falloff: 0.10),
        height_m: (min: 0.0, max: 3000.0, falloff: 200.0),
        max_slope_deg: 38.0,
        slope_falloff_deg: 8.0,
        rock_affinity: -1.0,
        soil_min: 0.15,
        water_bonus: 0.15,
        water_within_m: 40.0,
        base_density: 0.85,
        prior_weight: 0.5,
        patch_scale_m: 700.0,
        patch_coverage: 0.6,
        scale: (0.8, 1.3),
    ),
    look: (
        bark: (0.09, 0.055, 0.04),
        organ: (0.025, 0.085, 0.07),
        organ_tip: (0.05, 0.16, 0.11),
        accent: (0.25, 0.08, 0.04),
    ),
)
