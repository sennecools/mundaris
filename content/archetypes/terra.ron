// Terra: temperate world with oceans and continents
// (docs/ASTRUM_TERRAIN_PIPELINE.md §5.2–5.3).
//
// Ranges are sampled per body with per-stage seeds (§5.1). M1 (World map and
// planet editor) runs continents, sea level, shelf, temperature, wind and
// moisture; M2 (Shape) adds tectonics (plates, mountain belts, trenches,
// ridges, rock hardness), a rain shadow and macro erosion. Landforms follow.
(
    schema: 1,
    name: "terra",
    stages: [
        Continents, SeaLevel, Shelf, Temperature, Wind, Moisture,
        Tectonics, RainShadow, Erosion,
    ],
    // Face cells per body radius (§6.2); never depends on viewing distance.
    resolution: [
        (max_radius_km: 60.0, face_cells: 256),
        (max_radius_km: 400.0, face_cells: 512),
        (max_radius_km: 600.0, face_cells: 1024),
    ],
    ocean_coverage: (0.5, 0.7),
    continents: (
        // A 339 km body has a 2130 km circumference: a few continents.
        wavelength_km: (700.0, 1100.0),
        // Down to about two Tier A texels at 512² (wavelength ~1.4–2.1 km).
        octaves: 9,
        lacunarity: 2.0,
        gain: 0.5,
        warp_wavelength_km: (500.0, 900.0),
        warp_strength: (0.25, 0.45),
        land_height_m: (1800.0, 3200.0),
        // Above 1, most land stays low and only interiors rise high.
        land_exponent: 1.7,
        ocean_depth_m: (3200.0, 4800.0),
        shelf_depth_m: 140.0,
        shelf_fraction: 0.08,
    ),
    temperature: (
        equator_c: (24.0, 31.0),
        pole_c: (-38.0, -18.0),
        axial_tilt_deg: (12.0, 30.0),
        lapse_c_per_km: 6.5,
        ocean_moderation: 0.35,
        // Ocean influence reaches this far inland.
        ocean_blur_km: 120.0,
        noise_c: 1.5,
        noise_wavelength_km: 250.0,
    ),
    wind: (
        cells_per_hemisphere: 3,
        meridional_fraction: 0.3,
    ),
    moisture: (
        // 96 steps of 25 km reach 2400 km, more than once around a 339 km body.
        iterations: 96,
        step_km: 25.0,
        spread: 0.5,
        evaporation: (0.05, 0.07),
        // Rain-out per step: moisture falls to 1/e over about 25-40 steps inland.
        rain: (0.025, 0.04),
        precipitation_scale: 1.2,
        // Circulation-cell rain: wetter at the equator and ~60°, drier at
        // ~30° and the poles (Hadley, Ferrel and polar cells).
        convergence: 0.6,
    ),
    // Plates as a warped power diagram; profiles of the boundary distance
    // give belts, coastal ranges, trenches, ridges and rifts (M2 design §1).
    tectonics: (
        // A 339 km body: plates ~700 km across, a few microplates.
        plate_count: (9.0, 13.0),
        microplates: (2, 4),
        jitter: 0.6,
        micro_shrink: 0.04,
        continental_fraction: (0.35, 0.5),
        warp_wavelength_km: 500.0,
        warp_strength: (0.25, 0.4),
        speed: (0.3, 0.5),
        crust_weight: (0.35, 0.5),
        collision_height_m: (2500.0, 3500.0),
        arc_height_m: (1400.0, 2200.0),
        trench_depth_m: (2000.0, 3000.0),
        ridge_height_m: (900.0, 1500.0),
        rift_depth_m: 600.0,
        transform_height_m: 250.0,
        orogen_width_km: (120.0, 180.0),
        roughness: 0.5,
        roughness_wavelength_km: 60.0,
        arc_width_km: 55.0,
        arc_offset_km: 90.0,
        trench_width_km: 40.0,
        ridge_width_km: 100.0,
        rift_width_km: 50.0,
        transform_width_km: 25.0,
        crust_width_km: 120.0,
        softness_km: 40.0,
        boundary_clamp_km: 300.0,
    ),
    // Rock hardness 0 (soft sedimentary) .. 1 (hard crystalline); slows
    // erosion by up to 80 %.
    hardness: (
        crystalline: 0.85,
        volcanic: 0.7,
        sedimentary: 0.3,
        noise: 0.15,
        noise_wavelength_km: 300.0,
    ),
    // Wind turns around ranges; windward slopes rain out, lees dry.
    rain_shadow: (
        deflection: 0.5,
        deflection_slope: 0.02,
        slowdown: 0.3,
        orographic_rain: 0.08,
        lee_drying: 0.5,
        reference_slope: 0.02,
    ),
    // Stream-power macro erosion: drainage-organised valleys, sediment in
    // basins and deltas. Cascade 128² × 200 → 256² × 100 → 512² × 60 at 512².
    erosion: (
        strength: (12.0, 18.0),
        uplift_m: (400.0, 700.0),
        talus_deg: 35.0,
        deposition: 0.3,
        capacity: 2.0,
        area_exponent: 0.5,
        slope_exponent: 1.0,
        flow_exponent: 1.5,
        thermal_rate: 0.1,
        sediment_depth_m: 40.0,
        cascade: ((4, 200), (2, 100), (1, 60)),
    ),
    // Surface colour (§10): tint from the biome LUT by temperature × moisture.
    biome_lut: "lut/terra_whittaker.ron",
    // Snow where the climate is below freezing, except on steep slopes.
    snow: (
        material: "materials/snow/material.ron",
        temperature_c: -4.0,
        blend_c: 5.0,
        slope_deg: (35.0, 55.0),
    ),
    // Tier B climate detail: band-limited fBm on temperature and moisture so
    // biome borders break up and refine as you approach (zero-mean, so the
    // colour from orbit is unchanged).
    climate_detail: (
        base_wavelength_m: 20000.0,
        min_wavelength_m: 64.0,
        lacunarity: 2.0,
        gain: 0.6,
        temperature_c: 3.0,
        moisture: 0.12,
    ),
    // Flat water below sea level until M3 (Water).
    water: (
        shallow_linear: (0.025, 0.075, 0.085),
        deep_linear: (0.004, 0.014, 0.035),
        depth_scale_m: 120.0,
    ),
    // Measured for the canonical seed; gpu_terrain_colour.rs checks it (0.005).
    average_colour: (0.126, 0.130, 0.118),
)
