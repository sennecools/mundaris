{
  "schema": 1,
  "preset": "solar-system",
  "deterministic": true,
  "initial_settings": [{ "action": "reset" }, { "action": "pause", "paused": true }],
  "steps": [
    { "action": { "action": "select", "body": "solar:earth" } },
    { "action": { "action": "focus", "body": "solar:earth" } },
    { "action": { "action": "render_mode", "mode": "natural" } },
    { "action": { "action": "layer", "layer": "ocean", "enabled": true } },
    { "action": { "action": "layer", "layer": "clouds", "enabled": true } },
    { "action": { "action": "layer", "layer": "atmosphere", "enabled": true } },
    { "action": { "action": "layer", "layer": "sky", "enabled": true } },
    { "action": { "action": "sky_setting", "setting": "intensity", "value": 0.8 } },
    { "action": { "action": "sky_setting", "setting": "star_intensity", "value": 1.2 } },
    { "checkpoint": { "name": "earth-sky-ready", "predicate": { "path": "sky.enabled", "equals": true }, "timeout_s": 20 } },
    { "checkpoint": { "name": "earth-sky-intensity", "predicate": { "path": "sky.intensity", "approximately": 0.8, "tolerance": 0.001 }, "timeout_s": 20 } },
    { "checkpoint": { "name": "earth-star-intensity", "predicate": { "path": "sky.star_intensity", "approximately": 1.2, "tolerance": 0.001 }, "timeout_s": 20 } },
    { "capture": { "name": "earth-rendering-sky" } }
  ]
}
