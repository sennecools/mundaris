// Mundaris Studio main window (docs/STUDIO_UI.md).
// Every interaction is a callback that Rust maps to one typed command; the UI
// holds no engine state of its own beyond presentation (open panels, hover).
import { ScrollView, ComboBox, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Stat, ToolButton, Segmented, SectionHeader, StatRow, Card } from "widgets.slint";
import { Profiler, ProfilerData, FrameBar, LaneRow, SpanBox, Tick, HotSpan } from "profiler.slint";

export { Theme, Stat, ProfilerData, FrameBar, LaneRow, SpanBox, Tick, HotSpan }

export struct BodyRow {
    name: string,
    detail: string,
    depth: int,
    selected: bool,
    focused: bool,
}

// A placed body label in viewport logical pixels (laid out in Rust).
export struct BodyLabel {
    x: length,
    y: length,
    width: length,
    height: length,
    marker-x: length,
    marker-y: length,
    text: string,
    // 0 normal, 1 selected, 2 focused.
    state: int,
    leader: bool,
    show-marker: bool,
    ring: length,
}

export struct LogLine {
    time: string,
    text: string,
    tone: int,
}

component Toolbar inherits Rectangle {
    in property <bool> paused;
    in property <string> time-text;
    in property <int> rate-index;
    in property <int> camera-index;
    in property <[string]> view-modes;
    in property <int> view-index;
    in property <bool> terrain-enabled;
    in property <bool> labels-enabled;
    in property <bool> bottom-open;
    callback toggle-pause();
    callback set-rate(int);
    callback set-camera(int);
    callback set-view(int);
    callback toggle-terrain();
    callback toggle-labels();
    callback toggle-bottom();
    callback capture();

    height: 44px;
    background: Theme.surface-1;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;
        alignment: start;
        Text {
            text: "Mundaris";
            font-size: Theme.font-heading;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
        Rectangle { width: Theme.space-2; }
        VerticalLayout {
            alignment: center;
            ToolButton {
                text: root.paused ? "▶  Play" : "❚❚  Pause";
                active: !root.paused;
                clicked => { root.toggle-pause(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Segmented {
                options: ["1×", "10×", "100×", "1k×", "10k×", "100k×"];
                selected: root.rate-index;
                chosen(index) => { root.set-rate(index); }
            }
        }
        Text {
            text: root.time-text;
            font-size: Theme.font-mono;
            font-family: Theme.mono-family;
            color: Theme.text-secondary;
            vertical-alignment: center;
            min-width: 120px;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: "Camera";
            font-size: Theme.font-small;
            color: Theme.text-disabled;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Segmented {
                options: ["System", "Orbit", "Surface", "Free"];
                selected: root.camera-index;
                chosen(index) => { root.set-camera(index); }
            }
        }
        Text {
            text: "View";
            font-size: Theme.font-small;
            color: Theme.text-disabled;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            ComboBox {
                width: 130px;
                model: root.view-modes;
                current-index: root.view-index;
                selected(value) => { root.set-view(self.current-index); }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolButton {
                text: "Terrain";
                active: root.terrain-enabled;
                clicked => { root.toggle-terrain(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolButton {
                text: "Labels";
                active: root.labels-enabled;
                clicked => { root.toggle-labels(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolButton {
                text: "Profiler";
                active: root.bottom-open;
                clicked => { root.toggle-bottom(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ToolButton {
                text: "Capture";
                clicked => { root.capture(); }
            }
        }
    }
}

component Outliner inherits Rectangle {
    in property <[BodyRow]> bodies;
    callback select-body(int);
    callback focus-body(int);

    background: Theme.surface-1;
    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;
        SectionHeader { text: "SCENE"; detail: root.bodies.length + " bodies"; }
        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 1px;
                for body[index] in root.bodies: Rectangle {
                    height: 30px;
                    border-radius: Theme.radius-small;
                    background: body.selected ? Theme.accent-soft
                        : row-touch.has-hover ? Theme.surface-2 : transparent;
                    HorizontalLayout {
                        padding-left: Theme.space-2 + body.depth * 14px;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: body.focused ? Theme.ok
                                : body.selected ? Theme.accent : Theme.border-strong;
                        }
                        Text {
                            text: body.name;
                            font-size: Theme.font-ui;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: body.detail;
                            font-size: Theme.font-small;
                            color: Theme.text-disabled;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 0;
                        }
                    }
                    row-touch := TouchArea {
                        clicked => { root.select-body(index); }
                        double-clicked => { root.focus-body(index); }
                    }
                }
            }
        }
        Text {
            text: "Click selects · double-click focuses";
            font-size: Theme.font-small;
            color: Theme.text-disabled;
            wrap: word-wrap;
        }
    }
}

component Viewport inherits Rectangle {
    in property <image> scene;
    in property <[BodyLabel]> labels;
    in property <[Stat]> hud;
    // Pointer kinds: 0 move, 1 down, 2 up, 3 leave. Buttons: 0 none, 1 left, 2 right.
    callback pointer(int, int, length, length);
    callback scroll(length, length);
    callback clicked-at(length, length, bool);
    callback label-clicked(int, bool);
    callback key(string, bool, bool, bool) -> bool;
    callback focus-changed(bool);

    background: Theme.surface-0;
    clip: true;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.scene;
        image-fit: fill;
    }

    focus := FocusScope {
        key-pressed(event) => {
            return root.key(event.text, true, event.modifiers.shift, event.repeat) ? accept : reject;
        }
        key-released(event) => {
            return root.key(event.text, false, event.modifiers.shift, false) ? accept : reject;
        }
        focus-changed-event => { root.focus-changed(self.has-focus); }

        area := TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { focus.focus(); }
                root.pointer(
                    event.kind == PointerEventKind.down ? 1
                        : event.kind == PointerEventKind.up ? 2
                        : event.kind == PointerEventKind.cancel ? 3 : 0,
                    event.button == PointerEventButton.left ? 1
                        : event.button == PointerEventButton.right ? 2 : 0,
                    self.mouse-x, self.mouse-y);
            }
            moved => { root.pointer(0, 0, self.mouse-x, self.mouse-y); }
            scroll-event(event) => {
                root.pointer(0, 0, self.mouse-x, self.mouse-y);
                root.scroll(event.delta-x, event.delta-y);
                return accept;
            }
            clicked => { root.clicked-at(self.mouse-x, self.mouse-y, false); }
            double-clicked => { root.clicked-at(self.mouse-x, self.mouse-y, true); }
        }
    }

    for label[index] in root.labels: Rectangle {
        // Marker and selection ring at the body position.
        if label.show-marker: Rectangle {
            x: label.marker-x - parent.x - 4px;
            y: label.marker-y - parent.y - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            border-width: 1.3px;
            border-color: label.state == 1 ? Theme.warn : label.state == 2 ? Theme.ok : Theme.text-secondary;
        }
        if label.ring > 0: Rectangle {
            x: label.marker-x - parent.x - label.ring;
            y: label.marker-y - parent.y - label.ring;
            width: 2 * label.ring;
            height: 2 * label.ring;
            border-radius: label.ring;
            border-width: 1.5px;
            border-color: label.state == 1 ? Theme.warn : Theme.ok;
        }
        x: label.x;
        y: label.y;
        width: label.width;
        height: label.height;
        border-radius: 3px;
        background: #000000c0;
        Text {
            text: label.text;
            font-size: 12px;
            color: label.state == 1 ? Theme.warn : label.state == 2 ? Theme.ok : Theme.text-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        TouchArea {
            clicked => { root.label-clicked(index, false); }
            double-clicked => { root.label-clicked(index, true); }
        }
    }

    // Compact heads-up readout, top-left.
    Rectangle {
        x: Theme.space-3;
        y: Theme.space-3;
        width: 190px;
        height: hud-layout.preferred-height;
        border-radius: Theme.radius;
        background: #0b0e13b0;
        visible: root.hud.length > 0;
        hud-layout := VerticalLayout {
            padding: Theme.space-2;
            for stat in root.hud: StatRow { stat: stat; }
        }
    }
}

component Inspector inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <[Stat]> body-stats;
    in property <[Stat]> camera-stats;
    in property <[Stat]> terrain-stats;
    in property <float> speed-exponent;
    in property <bool> surface-available;
    in property <[bool]> overlays;
    callback toggle-overlay(int);
    callback set-speed-exponent(float);
    callback approach(int);
    callback surface-navigation();
    callback frame-selected();

    background: Theme.surface-1;
    ScrollView {
        VerticalLayout {
            padding: Theme.space-3;
            spacing: Theme.space-3;
            alignment: start;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.title;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.subtitle;
                    font-size: Theme.font-ui;
                    color: Theme.text-secondary;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                ToolButton {
                    text: "Frame";
                    clicked => { root.frame-selected(); }
                }
                ToolButton {
                    text: "Walk surface";
                    enabled: root.surface-available;
                    clicked => { root.surface-navigation(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Card {
                title: "BODY";
                stats: root.body-stats;
            }
            Card {
                title: "CAMERA";
                stats: root.camera-stats;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "0.01×";
                        font-size: Theme.font-small;
                        color: Theme.text-disabled;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: -2;
                        maximum: 2;
                        value: root.speed-exponent;
                        changed(value) => { root.set-speed-exponent(value); }
                    }
                    Text {
                        text: "100×";
                        font-size: Theme.font-small;
                        color: Theme.text-disabled;
                        vertical-alignment: center;
                    }
                }
                SectionHeader { text: "GO TO ALTITUDE"; }
                HorizontalLayout {
                    spacing: 2px;
                    for preset[index] in ["100 km", "10 km", "1 km", "100 m", "10 m", "2 m"]: ToolButton {
                        text: preset;
                        clicked => { root.approach(index); }
                    }
                }
            }
            Card {
                title: "TERRAIN";
                stats: root.terrain-stats;
            }
            Card {
                title: "OVERLAYS";
                HorizontalLayout {
                    spacing: Theme.space-1;
                    for name[index] in ["Markers", "Trails", "Orbit guides"]: ToolButton {
                        text: name;
                        active: root.overlays[index];
                        clicked => { root.toggle-overlay(index); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}

component LogView inherits Rectangle {
    in property <[LogLine]> lines;
    background: Theme.surface-1;
    ScrollView {
        VerticalLayout {
            padding: Theme.space-3;
            spacing: 2px;
            alignment: start;
            for line in root.lines: HorizontalLayout {
                spacing: Theme.space-2;
                Text {
                    text: line.time;
                    font-size: Theme.font-mono;
                    font-family: Theme.mono-family;
                    color: Theme.text-disabled;
                    horizontal-stretch: 0;
                }
                Text {
                    text: line.text;
                    font-size: Theme.font-ui;
                    color: Theme.tone-color(line.tone);
                    wrap: word-wrap;
                }
            }
        }
    }
}

component StatusBar inherits Rectangle {
    in property <[Stat]> items;
    in property <string> automation-owner;
    in property <string> build-text;
    callback stop-automation();

    height: 26px;
    background: Theme.surface-1;
    Rectangle {
        height: 1px;
        y: 0;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-4;
        for item in root.items: HorizontalLayout {
            spacing: Theme.space-1;
            horizontal-stretch: 0;
            Text {
                text: item.label;
                font-size: Theme.font-small;
                color: Theme.text-disabled;
                vertical-alignment: center;
            }
            Text {
                text: item.value;
                font-size: Theme.font-mono;
                font-family: Theme.mono-family;
                color: Theme.tone-color(item.tone);
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.automation-owner != "": HorizontalLayout {
            spacing: Theme.space-2;
            horizontal-stretch: 0;
            Text {
                text: "Automation: " + root.automation-owner;
                font-size: Theme.font-small;
                color: Theme.warn;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                ToolButton {
                    height: 20px;
                    text: "Stop";
                    clicked => { root.stop-automation(); }
                }
            }
        }
        Text {
            text: root.build-text;
            font-size: Theme.font-small;
            color: Theme.text-disabled;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}

export component StudioWindow inherits Window {
    title: "Mundaris Studio";
    preferred-width: 1600px;
    preferred-height: 900px;
    background: Theme.surface-0;
    default-font-size: Theme.font-ui;

    // Toolbar
    in property <bool> paused;
    in property <string> time-text;
    in property <int> rate-index: -1;
    in property <int> camera-index;
    in property <[string]> view-modes;
    in property <int> view-index;
    in property <bool> terrain-enabled: true;
    in property <bool> labels-enabled: true;
    in-out property <bool> bottom-open: true;
    in-out property <int> bottom-tab: 0;
    callback toggle-pause();
    callback set-rate(int);
    callback set-camera(int);
    callback set-view(int);
    callback toggle-terrain();
    callback toggle-labels();
    callback capture();

    // Outliner
    in property <[BodyRow]> bodies;
    callback select-body(int);
    callback focus-body(int);

    // Viewport
    in property <image> scene;
    in property <[BodyLabel]> labels;
    in property <[Stat]> hud;
    out property <length> viewport-width: viewport.width;
    out property <length> viewport-height: viewport.height;
    callback viewport-pointer(int, int, length, length);
    callback viewport-scroll(length, length);
    callback viewport-clicked(length, length, bool);
    callback viewport-label-clicked(int, bool);
    callback viewport-key(string, bool, bool, bool) -> bool;
    callback viewport-focus(bool);

    // Inspector
    in property <string> inspector-title;
    in property <string> inspector-subtitle;
    in property <[Stat]> body-stats;
    in property <[Stat]> camera-stats;
    in property <[Stat]> terrain-stats;
    in property <float> speed-exponent;
    in property <bool> surface-available;
    in property <[bool]> overlays: [true, false, false];
    callback toggle-overlay(int);
    callback set-speed-exponent(float);
    callback approach(int);
    callback surface-navigation();
    callback frame-selected();

    // Profiler and log
    in property <ProfilerData> profiler;
    callback profiler-set-enabled(bool);
    callback profiler-set-frozen(bool);
    callback profiler-export();
    callback profiler-capture();
    callback profiler-select-frame(int);
    callback profiler-follow-latest();
    callback profiler-select-span(int);
    callback profiler-set-full-frame(bool);
    in property <[LogLine]> log-lines;

    // Status bar
    in property <[Stat]> status-items;
    in property <string> automation-owner;
    in property <string> build-text;
    callback stop-automation();

    VerticalLayout {
        Toolbar {
            paused: root.paused;
            time-text: root.time-text;
            rate-index: root.rate-index;
            camera-index: root.camera-index;
            view-modes: root.view-modes;
            view-index: root.view-index;
            terrain-enabled: root.terrain-enabled;
            labels-enabled: root.labels-enabled;
            bottom-open: root.bottom-open;
            toggle-pause => { root.toggle-pause(); }
            set-rate(index) => { root.set-rate(index); }
            set-camera(index) => { root.set-camera(index); }
            set-view(index) => { root.set-view(index); }
            toggle-terrain => { root.toggle-terrain(); }
            toggle-labels => { root.toggle-labels(); }
            toggle-bottom => { root.bottom-open = !root.bottom-open; }
            capture => { root.capture(); }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            Outliner {
                width: 240px;
                bodies: root.bodies;
                select-body(index) => { root.select-body(index); }
                focus-body(index) => { root.focus-body(index); }
            }
            Rectangle { width: 1px; background: Theme.border; }
            VerticalLayout {
                horizontal-stretch: 1;
                viewport := Viewport {
                    vertical-stretch: 1;
                    scene: root.scene;
                    labels: root.labels;
                    hud: root.hud;
                    pointer(kind, button, x, y) => { root.viewport-pointer(kind, button, x, y); }
                    scroll(dx, dy) => { root.viewport-scroll(dx, dy); }
                    clicked-at(x, y, double) => { root.viewport-clicked(x, y, double); }
                    label-clicked(index, double) => { root.viewport-label-clicked(index, double); }
                    key(text, pressed, shift, repeat) => {
                        return root.viewport-key(text, pressed, shift, repeat);
                    }
                    focus-changed(focused) => { root.viewport-focus(focused); }
                }
                if root.bottom-open: Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                if root.bottom-open: VerticalLayout {
                    height: 340px;
                    Rectangle {
                        height: 32px;
                        background: Theme.surface-1;
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            spacing: Theme.space-1;
                            alignment: start;
                            for tab[index] in ["Profiler", "Log"]: VerticalLayout {
                                alignment: center;
                                ToolButton {
                                    text: tab;
                                    active: index == root.bottom-tab;
                                    clicked => { root.bottom-tab = index; }
                                }
                            }
                        }
                    }
                    if root.bottom-tab == 0: Profiler {
                        vertical-stretch: 1;
                        data: root.profiler;
                        set-enabled(value) => { root.profiler-set-enabled(value); }
                        set-frozen(value) => { root.profiler-set-frozen(value); }
                        export => { root.profiler-export(); }
                        capture => { root.profiler-capture(); }
                        select-frame(index) => { root.profiler-select-frame(index); }
                        follow-latest => { root.profiler-follow-latest(); }
                        select-span(index) => { root.profiler-select-span(index); }
                        set-full-frame(value) => { root.profiler-set-full-frame(value); }
                    }
                    if root.bottom-tab == 1: LogView {
                        vertical-stretch: 1;
                        lines: root.log-lines;
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }
            Inspector {
                width: 300px;
                title: root.inspector-title;
                subtitle: root.inspector-subtitle;
                body-stats: root.body-stats;
                camera-stats: root.camera-stats;
                terrain-stats: root.terrain-stats;
                speed-exponent: root.speed-exponent;
                surface-available: root.surface-available;
                overlays: root.overlays;
                toggle-overlay(index) => { root.toggle-overlay(index); }
                set-speed-exponent(value) => { root.set-speed-exponent(value); }
                approach(index) => { root.approach(index); }
                surface-navigation => { root.surface-navigation(); }
                frame-selected => { root.frame-selected(); }
            }
        }
        StatusBar {
            items: root.status-items;
            automation-owner: root.automation-owner;
            build-text: root.build-text;
            stop-automation => { root.stop-automation(); }
        }
    }
}
